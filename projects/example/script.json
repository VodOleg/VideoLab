      ]
    },
    {
      "id": "comb",
      "text": "Inside the hive, the open cells hold honey that is still drying, and the capped ones are finished and stored for winter.",
      "scene": {
        "type": "image",
        "src": "assets/honeycomb.svg",
        "caption": "Open cells dry, capped cells store",
