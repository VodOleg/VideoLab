          { "id": "dry", "label": "Dry", "detail": "fanned by wings" },
          { "id": "seal", "label": "Seal", "detail": "under a wax cap" }
        ]
      },
      "cues": [
        { "show": "slots" },
        { "at": "collects nectar", "point": "collect" },
