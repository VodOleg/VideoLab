{
  "name": "videolab",
  "version": "1.0.0",
  "description": "Make videos from a prompt: an AI agent writes a script; the stack voices, times, animates and renders it, locally and with free tools.",
  "private": true,
  "type": "module",
  "scripts": {
    "kit": "node src/kit.ts",
    "loop": "node src/loop.ts",
    "music": "node src/music.ts",
    "render": "node src/render.ts",
    "still": "node src/engine/cli.ts still",
    "studio": "node src/engine/studio.ts",
    "typecheck": "tsc --noEmit",
    "voice": "node src/voice.ts",
    "voicelab": "node src/voicelab.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
