    "@huggingface/transformers": "^3.8.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "opentype.js": "^2.0.0",
    "phonemizer": "1.2.1",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0"
